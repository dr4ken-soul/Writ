# Web environment. Copy to web/.env.local and fill in.
#
# The app renders an explicit "no deployment configured" state when the registry
# address is missing. It never falls back to a placeholder number.

# --- Required ---------------------------------------------------------------

# The deployed WritRegistry contract id. You get this from the output of your
# own deployment run, not from a website. Deploy the contracts, and the script
# prints the contract id; paste it here.
# Explorer, to confirm it: https://midnight.network/explorer
NEXT_PUBLIC_WRIT_REGISTRY_ADDRESS=

# The network you deployed to. One of:
#   undeployed   local devnet from midnight-local-dev
#   testnet      public test network
#   mainnet      public main network
# Source: https://www.npmjs.com/package/@midnight-ntwrk/midnight-js-network-id
NEXT_PUBLIC_NETWORK_ID=undeployed

# --- Local devnet only ------------------------------------------------------
# From midnight-local-dev. The node is on 9944 and the indexer on 8088.
# Guide: https://github.com/midnightntwrk/midnight-local-dev
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:9944

# --- Public networks --------------------------------------------------------
# Leave RPC_URL unset when you use the public networks: transactions are
# submitted through your wallet, not to a node you run yourself.
# NEXT_PUBLIC_RPC_URL=