# Repository environment. Copy to .env at the root and to web/.env.local for the
# frontend. Never commit a filled-in copy.
#
# AGENT_SIGNING_KEY belongs to a dedicated agent wallet used only to submit
# actions. It never holds principal funds and never appears in the frontend
# bundle.

# Browser visible.
NEXT_PUBLIC_NETWORK_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WRIT_REGISTRY_ADDRESS=
NEXT_PUBLIC_WALLET_CONNECT_ID=

# Agent service only. Never expose these with a NEXT_PUBLIC_ prefix.
AGENT_SIGNING_KEY=
AGENT_RPC_URL=
AGENT_POLL_INTERVAL_MS=15000